# ── Line endings: store LF in the repo; Git handles checkout conversion ────────
# This ensures Windows (CRLF) and macOS/Linux (LF) never create false diffs.
* text=auto eol=lf

# Source code — always LF
*.kt        text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.jsx       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.gradle    text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.pro       text eol=lf
Makefile    text eol=lf
*.sh        text eol=lf

# Windows-only scripts (keep CRLF on Windows checkout)
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary — never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.apk       binary
*.aab       binary
*.jar       binary
*.keystore  binary
*.jks       binary
*.zip       binary
*.gz        binary
*.tar       binary
