<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── App theme ────────────────────────────────────────────────────── -->
    <style name="Theme.DisasterMesh" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/civilian</item>
        <item name="colorPrimaryDark">@color/ink_950</item>
        <item name="colorAccent">@color/civilian</item>
        <item name="android:windowBackground">@color/ink_950</item>
        <item name="android:statusBarColor">@color/ink_900</item>
        <item name="android:navigationBarColor">@color/ink_900</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DisasterMesh.Sharp</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DisasterMesh.Sharp</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DisasterMesh.Sharp</item>
    </style>

    <!-- 0-radius corners everywhere — tactical aesthetic -->
    <style name="ShapeAppearance.DisasterMesh.Sharp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- ── Bottom Navigation ─────────────────────────────────────────────── -->
    <style name="Widget.DisasterMesh.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/ink_900</item>
        <item name="itemIconTint">@color/text_dim</item>
        <item name="itemTextColor">@color/text_dim</item>
        <item name="itemRippleColor">@color/border_default</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.DisasterMesh.BottomNav.ActiveIndicator" parent="">
        <item name="android:color">#22161B22</item>
        <item name="android:width">40dp</item>
        <item name="android:height">22dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DisasterMesh.NavPill</item>
    </style>

    <style name="ShapeAppearance.DisasterMesh.NavPill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- ── Bottom Sheet ──────────────────────────────────────────────────── -->
    <style name="Widget.DisasterMesh.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.DisasterMesh.Sharp</item>
        <item name="android:background">@color/ink_900</item>
    </style>

    <!-- ── Buttons ───────────────────────────────────────────────────────── -->
    <style name="Widget.DisasterMesh.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/ink_950</item>
        <item name="backgroundTint">@color/civilian</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DisasterMesh.Sharp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DisasterMesh.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DisasterMesh.Sharp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DisasterMesh.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DisasterMesh.Sharp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ── Text Input ────────────────────────────────────────────────────── -->
    <style name="Widget.DisasterMesh.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/ink_800</item>
        <item name="boxStrokeColor">@color/border_strong</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DisasterMesh.Sharp</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="hintTextColor">@color/text_muted</item>
    </style>

    <!-- ── Progress ──────────────────────────────────────────────────────── -->
    <style name="Widget.DisasterMesh.ProgressBar" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="trackCornerRadius">0dp</item>
        <item name="trackColor">@color/ink_700</item>
        <item name="indicatorColor">@color/civilian</item>
    </style>

    <!-- ── Text appearances ──────────────────────────────────────────────── -->
    <style name="TextAppearance.DisasterMesh.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">8sp</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <style name="TextAppearance.DisasterMesh.NavLabel.Compact" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <style name="TextAppearance.DisasterMesh.Mono.Tiny" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">7sp</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="TextAppearance.DisasterMesh.Mono.Caption" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.DisasterMesh.Mono.Label" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.DisasterMesh.Mono.Body" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.DisasterMesh.Mono.Title" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ── Suggestion list (AI first-run picker) ───────────────────────── -->
    <style name="Widget.DisasterMesh.SuggestionRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_btn_neutral</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.DisasterMesh.SuggestionAccent" parent="">
        <item name="android:layout_width">2dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:background">@color/civilian</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <style name="Widget.DisasterMesh.SuggestionLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.DisasterMesh.SuggestionArrow" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:text">→</item>
    </style>

</resources>
