<?xml version="1.0" encoding="utf-8"?>
<!--
    Default card surface. ink_900 base (#080808) with a 1dp border.
    border_default (#181818) keeps the card subtle against the grid background
    while remaining visually distinct from ink_950 (#000000).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ink_900" />
    <stroke android:width="1dp" android:color="@color/border_default" />
</shape>
