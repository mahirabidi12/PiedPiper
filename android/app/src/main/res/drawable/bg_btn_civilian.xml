<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_950" />
            <stroke android:width="1dp" android:color="#1A58A6FF" />
        </shape>
    </item>

    <!-- Pressed: deeper tint + full-opacity civilian stroke -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#002840" />
            <stroke android:width="2dp" android:color="@color/civilian" />
        </shape>
    </item>

    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#002840" />
            <stroke android:width="2dp" android:color="@color/civilian" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/civilian_tint" />
            <stroke android:width="1dp" android:color="@color/civilian" />
        </shape>
    </item>

</selector>
