<?xml version="1.0" encoding="utf-8"?>
<!--
    Selected role card — used when the user has tapped a role in the login flow.
    ink_800 fill + civilian stroke (active selection accent).
    The exact stroke color is overridden programmatically per role;
    this drawable provides the structural definition for civilian (default).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed while selected -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/civilian_tint" />
            <stroke android:width="2dp" android:color="@color/civilian" />
        </shape>
    </item>

    <!-- Selected / checked normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_800" />
            <stroke android:width="1dp" android:color="@color/civilian" />
        </shape>
    </item>

</selector>
