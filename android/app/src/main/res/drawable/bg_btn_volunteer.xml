<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_950" />
            <stroke android:width="1dp" android:color="#1A3FB950" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#003D14" />
            <stroke android:width="2dp" android:color="@color/volunteer" />
        </shape>
    </item>

    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#003D14" />
            <stroke android:width="2dp" android:color="@color/volunteer" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/volunteer_tint" />
            <stroke android:width="1dp" android:color="@color/volunteer" />
        </shape>
    </item>

</selector>
