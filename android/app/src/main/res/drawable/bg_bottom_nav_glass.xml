<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom navigation bar background.
    Sharp (0dp) corner radius — tactical aesthetic, no pill rounding.
    ink_900 fill at 96% opacity + a subtle top border for visual separation.
    The border_default color (#181818) keeps it consistent with the card system.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5080808" />
        </shape>
    </item>

    <!-- Top border accent — 1dp line separating nav from content -->
    <item android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/border_strong" />
        </shape>
    </item>

</layer-list>
