<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_950" />
            <stroke android:width="1dp" android:color="#1AFF4D4D" />
        </shape>
    </item>

    <!-- Pressed: brighter critical fill + full-opacity stroke -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#330000" />
            <stroke android:width="2dp" android:color="@color/priority_critical" />
        </shape>
    </item>

    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#330000" />
            <stroke android:width="2dp" android:color="@color/priority_critical" />
        </shape>
    </item>

    <!-- Normal: standard critical tint + 1dp stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/critical_tint" />
            <stroke android:width="1dp" android:color="@color/priority_critical" />
        </shape>
    </item>

</selector>
