<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ink_900">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/border_strong" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RESOLVE TICKET"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border_default" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Category / priority row -->
            <TextView
                android:id="@+id/tvResolveCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Message -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_terminal_block"
                android:padding="12dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:id="@+id/tvResolveMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>

            <!-- Assigned volunteer (shown if assigned) -->
            <LinearLayout
                android:id="@+id/containerAssigned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_btn_neutral"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLUNTEER"
                    android:fontFamily="monospace"
                    android:textSize="8sp"
                    android:letterSpacing="0.10"
                    android:textColor="@color/text_dim"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:id="@+id/tvAssignedVol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="@color/volunteer" />
            </LinearLayout>

            <!-- Inventory consumed (shown if allocated) -->
            <LinearLayout
                android:id="@+id/containerInventoryConsumed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_btn_neutral"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESOURCES ALLOCATED"
                    android:fontFamily="monospace"
                    android:textSize="8sp"
                    android:letterSpacing="0.10"
                    android:textColor="@color/text_dim"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvInventoryConsumed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnMarkUnresolvable"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_critical"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/priority_critical"
                        android:text="UNRESOLVABLE" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnConfirmResolve"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_authority"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/authority"
                        android:text="CONFIRM RESOLVED" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
