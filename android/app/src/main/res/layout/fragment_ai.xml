<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_950">

    <!-- ── Status bar ───────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/ink_900">

        <View
            android:id="@+id/aiStatusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@color/ai_absent"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvAiStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:textColor="@color/ai_absent"
            android:text="MODEL ABSENT" />

        <!-- Language switcher button -->
        <LinearLayout
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_btn_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginEnd="4dp"
                android:text="🌐" />
            <TextView
                android:id="@+id/tvCurrentLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:textColor="@color/civilian"
                android:letterSpacing="0.08"
                android:text="EN" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.08"
            android:text="Gemma 4 E2B · LiteRT" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <!-- ── Download panel (shown when model is ABSENT) ──────────────────── -->
    <LinearLayout
        android:id="@+id/downloadPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/ink_900"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDownloadInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="12dp" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressDownload"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:progressTint="@color/civilian"
            android:progressBackgroundTint="@color/ink_700"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <!-- Download / Cancel button -->
        <LinearLayout
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_civilian"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="2dp"
                android:layout_height="16dp"
                android:background="@color/civilian"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvDownloadBtnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/civilian"
                android:letterSpacing="0.12"
                android:text="DOWNLOAD MODEL (~2.6 GB)" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="RESUMABLE · BACKGROUND · ONE-TIME · WORKS OFFLINE AFTER" />
    </LinearLayout>

    <!-- ── Mode toggle: SURVIVAL | SITREP ──────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/ink_900"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tabSurvival"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:letterSpacing="0.10"
            android:textStyle="bold"
            android:textColor="@color/civilian"
            android:background="@color/ink_700"
            android:clickable="true"
            android:focusable="true"
            android:text="SURVIVAL" />

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="@color/border_default" />

        <TextView
            android:id="@+id/tabSitrep"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:letterSpacing="0.10"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:text="SITREP" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <!-- ── Chat thread bar (session + new-thread action) ────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="2dp"
            android:layout_height="10dp"
            android:background="@color/civilian"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:letterSpacing="0.10"
            android:textColor="@color/text_muted"
            android:text="SURVIVAL CHAT" />

        <TextView
            android:id="@+id/btnNewSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.08"
            android:clickable="true"
            android:focusable="true"
            android:text="+ NEW" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <!-- ── Chat-style conversation list ─────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAiMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls" />

        <!-- First-run suggestion panel — visible ONLY when the chat is empty
             AND the input is empty. Mounts to a no-op the moment the user
             types a character or fires any query. -->
        <ScrollView
            android:id="@+id/suggestionPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:text="Ask a survival question" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="22dp"
                    android:text="Pick a starter below, or type your own.\nThe assistant works fully offline." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="10dp"
                        android:background="@color/civilian"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="8sp"
                        android:letterSpacing="0.14"
                        android:textColor="@color/text_muted"
                        android:text="QUICK START" />
                </LinearLayout>

                <!-- Each row is a tactical, full-width tappable bar. -->
                <LinearLayout
                    android:id="@+id/suggestion1"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="How do I treat a deep cut?" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/suggestion2"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="What supplies do I need for a flood?" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/suggestion3"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="How can I make water safer to drink?" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/suggestion4"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="What is the safest shelter during an aftershock?" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- SITREP first-run suggestion panel — visible when SITREP mode is active
             and the chat is empty with no typed input. -->
        <ScrollView
            android:id="@+id/suggestionPanelSitrep"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:text="Ask about the situation" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="22dp"
                    android:text="Query the live mesh state.\nAnswers reflect your role's data only." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="10dp"
                        android:background="@color/civilian"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="8sp"
                        android:letterSpacing="0.14"
                        android:textColor="@color/text_muted"
                        android:text="QUICK START" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sitrepSuggestion1"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="What is the most critical active incident?" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sitrepSuggestion2"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="Summarize all unassigned tasks" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sitrepSuggestion3"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="How many peers are currently connected?" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sitrepSuggestion4"
                    style="@style/Widget.DisasterMesh.SuggestionRow">
                    <View style="@style/Widget.DisasterMesh.SuggestionAccent" />
                    <TextView
                        style="@style/Widget.DisasterMesh.SuggestionLabel"
                        android:text="Which signals need immediate attention?" />
                    <TextView style="@style/Widget.DisasterMesh.SuggestionArrow" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ── Input row ────────────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ink_900"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_dark">

            <EditText
                android:id="@+id/etQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:hint="Ask a survival question…"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAiMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_neutral"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_mic"
            android:scaleType="center"
            android:tint="@color/ai_absent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Microphone" />

        <LinearLayout
            android:id="@+id/btnAsk"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_civilian"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.4">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:textColor="@color/civilian"
                android:text="↑" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>