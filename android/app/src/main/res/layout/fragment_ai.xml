<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_950">

    <!-- ── Status bar ───────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/ink_900">

        <View
            android:id="@+id/aiStatusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@color/ai_absent"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvAiStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:textColor="@color/ai_absent"
            android:text="MODEL ABSENT" />

        <!-- Language switcher button -->
        <LinearLayout
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_btn_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginEnd="4dp"
                android:text="🌐" />
            <TextView
                android:id="@+id/tvCurrentLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:textColor="@color/civilian"
                android:letterSpacing="0.08"
                android:text="EN" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.08"
            android:text="Gemma 4 E2B · LiteRT" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <!-- ── Download panel (shown when model is ABSENT) ──────────────────── -->
    <LinearLayout
        android:id="@+id/downloadPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/ink_900"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDownloadInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="12dp" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressDownload"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:progressTint="@color/civilian"
            android:progressBackgroundTint="@color/ink_700"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <!-- Download / Cancel button -->
        <LinearLayout
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_civilian"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="2dp"
                android:layout_height="16dp"
                android:background="@color/civilian"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvDownloadBtnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/civilian"
                android:letterSpacing="0.12"
                android:text="DOWNLOAD MODEL (~2.6 GB)" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="RESUMABLE · BACKGROUND · ONE-TIME · WORKS OFFLINE AFTER" />
    </LinearLayout>

    <!-- ── Answer scroll area ───────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/scrollAnswer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.5"
            android:text="Ask a survival question. The assistant works fully offline once the model is downloaded." />
    </ScrollView>

    <!-- ── Quick-prompt chips ────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/chipCut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_neutral"
            android:padding="7dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.06"
            android:clickable="true"
            android:focusable="true"
            android:text="Treat deep cut?" />

        <TextView
            android:id="@+id/chipShelter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_neutral"
            android:padding="7dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.06"
            android:clickable="true"
            android:focusable="true"
            android:text="Shelter aftershock?" />

        <TextView
            android:id="@+id/chipWater"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_btn_neutral"
            android:padding="7dp"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.06"
            android:clickable="true"
            android:focusable="true"
            android:text="Purify water?" />
    </LinearLayout>

    <!-- ── Input row ────────────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ink_900"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_dark"
            android:padding="10dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:hint="Ask a survival question…"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3" />

        <LinearLayout
            android:id="@+id/btnAsk"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_civilian"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.4">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:textColor="@color/civilian"
                android:text="↑" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
