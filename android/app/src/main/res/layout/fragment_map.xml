<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_950">

    <!-- OSMDroid map -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Legend overlay (top-left) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ink_900"
        android:padding="8dp"
        android:layout_margin="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="7sp"
            android:letterSpacing="0.10"
            android:textColor="@color/text_muted"
            android:text="SIGNAL MAP"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/priority_critical"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="7sp"
                android:textColor="@color/text_muted"
                android:text="CRITICAL" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/priority_high"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="7sp"
                android:textColor="@color/text_muted"
                android:text="HIGH" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/priority_normal"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="7sp"
                android:textColor="@color/text_muted"
                android:text="NORMAL / LOW" />
        </LinearLayout>
    </LinearLayout>

    <!-- Signal count badge (bottom-right) -->
    <LinearLayout
        android:id="@+id/mapSignalBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ink_900"
        android:padding="8dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp">
        <TextView
            android:id="@+id/tvMapSignalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:textColor="@color/text_muted"
            android:text="0 SIGNALS ON MAP" />
    </LinearLayout>

    <!-- Drop-mode banner (authority only, visible when dropMode = true) -->
    <LinearLayout
        android:id="@+id/bannerDropMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_btn_authority"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:visibility="gone">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:textColor="@color/authority"
            android:text="▲ DROP MODE — tap map to place safe zone" />
        <TextView
            android:id="@+id/btnExitDropMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="@color/authority"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</FrameLayout>
