<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width broadcast banner — shown for any message starting with [BROADCAST -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_broadcast"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <!-- ⚡ icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡"
        android:textSize="14sp"
        android:textColor="@color/authority"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Sender + timestamp row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/tvBroadcastSender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/authority" />

            <TextView
                android:id="@+id/tvBroadcastTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="7sp"
                android:textColor="@color/text_dim" />

            <TextView
                android:id="@+id/btnBroadcastSpeak"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="SPK"
                android:fontFamily="monospace"
                android:textSize="7sp"
                android:textStyle="bold"
                android:textColor="@color/ai_ready"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Message text -->
        <TextView
            android:id="@+id/tvBroadcastText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</LinearLayout>
