<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_default"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Top row: label + count + unit + controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Count stepper: [−] EditText [+] -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/ink_800"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="−"
                android:textSize="18sp"
                android:textColor="@color/priority_critical"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <EditText
                android:id="@+id/tvCount"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:inputType="number"
                android:text="0"
                android:fontFamily="monospace"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:maxLength="5" />

            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textColor="@color/volunteer"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Label + meta -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="9sp"
                    android:textColor="@color/text_dim"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvStockBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="8sp"
                    android:textColor="@color/volunteer"
                    android:background="@color/volunteer_tint"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Delete button (authority only) -->
        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="10sp"
            android:textColor="@color/text_dim"
            android:background="@color/ink_800"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Updated by row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvUpdatedBy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_dim" />

        <TextView
            android:id="@+id/tvUpdatedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textColor="@color/text_dim" />
    </LinearLayout>
</LinearLayout>
