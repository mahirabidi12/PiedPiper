<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ink_900">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/border_strong" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ASSIGN TICKET"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border_default" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Signal summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_terminal_block"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvAssignSignalSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvAssignMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>

            <!-- Volunteer multi-select section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSIGN VOLUNTEERS"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:letterSpacing="0.14"
                android:textColor="@color/text_dim"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic volunteer checkboxes inserted here -->
            <LinearLayout
                android:id="@+id/containerVolunteers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_terminal_block"
                android:padding="8dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvNoVolunteers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No volunteers online"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="@color/text_dim"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- Instructions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TASK INSTRUCTIONS"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:letterSpacing="0.14"
                android:textColor="@color/text_dim"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:gravity="top"
                android:hint="E.g. Bring 2 medkits, report to sector 4, contact via radio ch. 3"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:background="@drawable/bg_terminal_block"
                android:padding="10dp"
                android:fontFamily="monospace"
                android:layout_marginBottom="14dp" />

            <!-- Inventory allocation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALLOCATE RESOURCES (OPTIONAL)"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:letterSpacing="0.14"
                android:textColor="@color/text_dim"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNoInventory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No inventory items available"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/containerInventoryInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp" />

            <!-- Confirm -->
            <LinearLayout
                android:id="@+id/btnConfirmAssign"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_volunteer"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:textColor="@color/volunteer"
                    android:text="CONFIRM ASSIGN" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
