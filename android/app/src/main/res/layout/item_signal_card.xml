<?xml version="1.0" encoding="utf-8"?>
<!-- Priority accent color set programmatically in SignalAdapter -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_default"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Priority left accent bar (color set programmatically) -->
    <View
        android:id="@+id/signalPriorityAccent"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/priority_critical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="top">

        <!-- Category icon box -->
        <LinearLayout
            android:id="@+id/signalIconBox"
            android:layout_width="@dimen/icon_box_sm"
            android:layout_height="@dimen/icon_box_sm"
            android:gravity="center"
            android:background="@color/critical_tint"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/tvCategoryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✚"
                android:textSize="11sp"
                android:textColor="@color/category_medical" />
        </LinearLayout>

        <!-- Content column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Chips row: category + status + time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/category_medical"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="8sp"
                    android:textColor="@color/status_new"
                    android:background="@drawable/bg_btn_neutral"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginEnd="6dp" />

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="7sp"
                    android:textColor="@color/text_dim" />
            </LinearLayout>

            <!-- Message text -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="5dp" />

            <!-- Meta row: sender + people -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSenderBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:textColor="@color/civilian"
                    android:background="@drawable/bg_btn_neutral"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvSenderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginEnd="8dp" />

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvPeopleCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Cancel button — shown only on authority screens -->
            <TextView
                android:id="@+id/btnCancelTicket"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="CANCEL TICKET"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:letterSpacing="0.10"
                android:textColor="@color/priority_critical"
                android:background="@color/critical_tint"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
