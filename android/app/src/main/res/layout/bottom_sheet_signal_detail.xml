<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ink_900">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/border_strong" />

    <!-- Priority header -->
    <LinearLayout
        android:id="@+id/signalDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_critical">

        <LinearLayout
            android:id="@+id/detailIconBox"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:background="@color/ink_800"
            android:layout_marginEnd="12dp">
            <TextView
                android:id="@+id/tvDetailCategoryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:text="?" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:text="PROCESSING" />
            <TextView
                android:id="@+id/tvDetailPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp"
                android:text="PRIORITY" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:letterSpacing="0.10"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_btn_neutral"
            android:text="NEW" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Message text -->
            <TextView
                android:id="@+id/tvDetailMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="14dp" />

            <!-- AI SITREP box -->
            <LinearLayout
                android:id="@+id/containerAiSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_btn_neutral"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@color/ai_ready"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="7sp"
                        android:letterSpacing="0.14"
                        android:textColor="@color/ai_ready"
                        android:text="AI SITREP" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailAiSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.4"
                    android:text="AI classification pending…" />
            </LinearLayout>

            <!-- Metadata grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_terminal_block"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="7sp"
                    android:letterSpacing="0.14"
                    android:textColor="@color/text_dim"
                    android:text="SIGNAL DETAILS"
                    android:layout_marginBottom="10dp" />

                <!-- Sender -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textColor="@color/text_dim"
                        android:text="SENDER" />
                    <TextView
                        android:id="@+id/tvDetailSender"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textColor="@color/text_dim"
                        android:text="LOCATION" />
                    <TextView
                        android:id="@+id/tvDetailLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Affected people -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textColor="@color/text_dim"
                        android:text="AFFECTED" />
                    <TextView
                        android:id="@+id/tvDetailPeople"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Raised time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textColor="@color/text_dim"
                        android:text="RAISED" />
                    <TextView
                        android:id="@+id/tvDetailTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Mesh hops -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:textColor="@color/text_dim"
                        android:text="MESH" />
                    <TextView
                        android:id="@+id/tvDetailMesh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action buttons (authority / volunteer) -->
            <LinearLayout
                android:id="@+id/containerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnDetailAcknowledge"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_volunteer"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tvAckLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:letterSpacing="0.10"
                        android:textColor="@color/volunteer"
                        android:text="ACKNOWLEDGE" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDetailResolve"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_authority"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tvResolveLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="9sp"
                        android:letterSpacing="0.10"
                        android:textColor="@color/authority"
                        android:text="RESOLVE" />
                </LinearLayout>
            </LinearLayout>

            <!-- Civilian read-only note -->
            <TextView
                android:id="@+id/tvDetailCivilianNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="@color/text_dim"
                android:gravity="center"
                android:padding="8dp"
                android:visibility="gone"
                android:text="Signal relayed across the mesh. Volunteers have been notified." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
