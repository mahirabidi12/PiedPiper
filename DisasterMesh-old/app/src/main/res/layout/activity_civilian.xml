<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ DISASTER MESH"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIV"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/badge_bg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCivName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#8B949E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCivPeerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Searching..."
                android:textColor="#F78166"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#21262D"/>

    <!-- Send signal section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0D1117">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Quick chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Emergency Type"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/chipCivSos"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="🚨 SOS"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#B91C1C"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/chipCivMedical"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="🏥 Medical"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D97706"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/chipCivRescue"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="🆘 Rescue"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#7C3AED"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/chipCivResource"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="📦 Supply"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1F6FEB"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Message input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Describe the emergency"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCivMessage"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="e.g. 3 people trapped near the school building, water rising fast"
                android:textColorHint="#484F58"
                android:textColor="#E6EDF3"
                android:textSize="15sp"
                android:background="@drawable/input_background"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"
                android:importantForAutofill="no" />

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your location"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etCivLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="e.g. Near MG Road school, North Gate"
                    android:textColorHint="#484F58"
                    android:textColor="#E6EDF3"
                    android:textSize="14sp"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/btnGps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="📍 GPS"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#21262D"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Tap GPS to capture coordinates"
                android:textColor="#484F58"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <!-- Send -->
            <Button
                android:id="@+id/btnCivSend"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SEND EMERGENCY SIGNAL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#B91C1C"
                android:layout_marginTop="20dp"
                android:stateListAnimator="@null" />

            <!-- Sent signals -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your sent signals"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSentSignals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
