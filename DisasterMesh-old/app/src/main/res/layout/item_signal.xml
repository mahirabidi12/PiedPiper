<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/cluster_card_bg"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Top row: sender + priority + category + time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvSignalSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSignalPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/badge_bg"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tvSignalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#484F58"
            android:textSize="10sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Category -->
    <TextView
        android:id="@+id/tvSignalCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Summary -->
    <TextView
        android:id="@+id/tvSignalSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E6EDF3"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="6dp" />

    <!-- Raw message -->
    <TextView
        android:id="@+id/tvSignalRaw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8B949E"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp" />

    <!-- Tags -->
    <TextView
        android:id="@+id/tvSignalTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#58A6FF"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- Location -->
    <TextView
        android:id="@+id/tvSignalLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <!-- People count -->
    <TextView
        android:id="@+id/tvSignalPeople"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
