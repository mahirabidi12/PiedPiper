<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B22"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- App title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ DISASTER MESH"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Offline AI assistant — opens AssistantActivity -->
            <Button
                android:id="@+id/btnAssistant"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:text="🤖"
                android:textSize="14sp"
                android:backgroundTint="#21262D"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp" />

            <!-- Role badge -->
            <TextView
                android:id="@+id/tvRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIV"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/badge_bg" />
        </LinearLayout>

        <!-- User name + peer status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#8B949E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPeerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Searching..."
                android:textColor="#F78166"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#21262D" />

    <!-- ── Quick chips (User only, hidden for other roles) ── -->
    <LinearLayout
        android:id="@+id/rowChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="#0D1117"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/chipSos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🚨 SOS"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B91C1C"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/chipMedical"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🏥 Medical"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D97706"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/chipSupply"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📦 Supply"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6FEB"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- ── Target selector (User only) ── -->
    <LinearLayout
        android:id="@+id/rowTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#161B22"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send to:"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:layout_marginEnd="12dp" />

        <Spinner
            android:id="@+id/spinnerTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_bg"
            android:paddingHorizontal="8dp" />

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#21262D" />

    <!-- ── Message list ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#21262D" />

    <!-- ── Input bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#161B22"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Describe your emergency..."
            android:textColorHint="#484F58"
            android:textColor="#E6EDF3"
            android:textSize="15sp"
            android:background="@drawable/input_background"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:imeOptions="actionSend"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6FEB"
            android:paddingHorizontal="18dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
